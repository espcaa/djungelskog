{
  "_metadata": {
    "major_version": 2
  },
  "display_information": {
    "name": "djungelskog",
    "description": "anon bot for #lgbtq-space!",
    "background_color": "#835C3B"
  },
  "features": {
    "bot_user": {
      "display_name": "djungelskog",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/djungelskog",
        "url": "https://djungelskog.hackclub.cc/events",
        "description": "submit an anon message to #lgbtq-space",
        "usage_hint": "<message>"
      }
